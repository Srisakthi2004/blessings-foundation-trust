<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 90" width="100%" height="100%">
  <defs>
    <linearGradient id="gradLogo" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f58220" />
      <stop offset="100%" stop-color="#e06900" />
    </linearGradient>
    <linearGradient id="gradLeaf" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1b8a5a" />
      <stop offset="100%" stop-color="#34c759" />
    </linearGradient>
  </defs>
  <!-- Emblem: Stylized hands & caring leaf -->
  <g transform="translate(10, 10)">
    <!-- Base circle glow -->
    <circle cx="35" cy="35" r="32" fill="#fff7ed" stroke="#f58220" stroke-width="2.5" />
    <!-- Sun rays of hope -->
    <circle cx="35" cy="35" r="16" fill="url(#gradLogo)" opacity="0.9" />
    <!-- Protective caring leaves/hands -->
    <path d="M 22 46 C 22 34, 35 24, 48 30 C 42 42, 32 48, 22 46 Z" fill="url(#gradLeaf)" />
    <path d="M 48 46 C 48 34, 35 24, 22 30 C 28 42, 38 48, 48 46 Z" fill="url(#gradLogo)" opacity="0.85" />
    <circle cx="35" cy="24" r="4.5" fill="#f58220" />
  </g>
  <!-- Brand Name Typography -->
  <text x="90" y="42" font-family="'Outfit', 'Segoe UI', Arial, sans-serif" font-size="24" font-weight="800" fill="#1b3b5f" letter-spacing="-0.5">
    BLESSINGS
  </text>
  <text x="90" y="64" font-family="'Inter', 'Segoe UI', Arial, sans-serif" font-size="13" font-weight="600" fill="#f58220" letter-spacing="2.5">
    FOUNDATION &amp; TRUST
  </text>
</svg>
