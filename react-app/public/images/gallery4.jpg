<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="g4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#b45309" />
      <stop offset="100%" stop-color="#f58220" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#g4)" />
  <circle cx="300" cy="180" r="130" fill="#ffffff" opacity="0.12" />
  <!-- Smiling child and protective wings -->
  <g transform="translate(240, 90)" fill="#ffffff">
    <circle cx="60" cy="50" r="30" />
    <!-- Smile -->
    <path d="M 45 55 Q 60 70, 75 55" fill="none" stroke="#b45309" stroke-width="4" stroke-linecap="round" />
    <!-- Eyes -->
    <circle cx="50" cy="45" r="4" fill="#b45309" />
    <circle cx="70" cy="45" r="4" fill="#b45309" />
    <!-- Cheerful hands -->
    <path d="M 60 85 C 30 95, 10 120, 10 150 L 110 150 C 110 120, 90 95, 60 85 Z" opacity="0.9" />
    <!-- Heart in center -->
    <path d="M 60 110 C 60 100, 48 95, 48 105 C 48 115, 60 125, 60 130 C 60 125, 72 115, 72 105 C 72 95, 60 100, 60 110 Z" fill="#f58220" />
  </g>
  <rect x="0" y="320" width="600" height="80" fill="#78350f" opacity="0.85" />
  <text x="30" y="355" font-family="'Outfit', sans-serif" font-size="20" font-weight="700" fill="#ffffff">
    Child Nutrition &amp; Welfare Support
  </text>
  <text x="30" y="380" font-family="'Inter', sans-serif" font-size="13" fill="#fed7aa" font-weight="500">
    Blessings Foundation &amp; Trust &bull; Nurturing Every Child's Potential
  </text>
</svg>
