<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0e7490" />
      <stop offset="100%" stop-color="#155e75" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#g2)" />
  <circle cx="300" cy="180" r="130" fill="#ffffff" opacity="0.1" />
  <!-- Medical Stethoscope / Cross Symbol -->
  <g transform="translate(250, 90)">
    <!-- Red/Orange Cross -->
    <rect x="35" y="10" width="30" height="80" rx="6" fill="#f58220" />
    <rect x="10" y="35" width="80" height="30" rx="6" fill="#f58220" />
    <!-- Heartbeat pulse -->
    <path d="M -30 140 L 20 140 L 35 110 L 55 170 L 75 125 L 90 145 L 140 145" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  </g>
  <rect x="0" y="320" width="600" height="80" fill="#082f49" opacity="0.85" />
  <text x="30" y="355" font-family="'Outfit', sans-serif" font-size="20" font-weight="700" fill="#ffffff">
    Free Healthcare &amp; Wellness Camp
  </text>
  <text x="30" y="380" font-family="'Inter', sans-serif" font-size="13" fill="#38bdf8" font-weight="500">
    Blessings Foundation &amp; Trust &bull; Preventative Care for All
  </text>
</svg>
